    <flight_control name="Learjet 35A">
        <channel name="Controls">
            <summer name="Elevator Sum">
                <input>fcs/elevator-cmd-norm</input>
                <clipto><min>-1</min><max>1</max></clipto>
            </summer>
            <aerosurface_scale name="Elevator">
                <input>fcs/elevator-sum</input>
                <range><min>-0.2793</min><max>0.2618</max></range>
                <output>fcs/elevator-pos-rad</output>
            </aerosurface_scale>
            <kinematic name="Stabilizer Trim">
                <input>fcs/pitch-trim-cmd-norm</input>
                <traverse>
                    <setting>
                        <position> -1 </position>
                        <time> 0 </time>
                    </setting>
                    <setting>
                        <position> 1 </position>
                        <time> 16.0 </time>
                    </setting>
                </traverse>
                <output>fcs/stabilizer-trim-norm</output>
            </kinematic>
            <aerosurface_scale name="Stabilizer">
                <input>fcs/stabilizer-trim-norm</input>
                <range><min>-0.1326</min><max>0.0070</max></range>
                <output>fcs/stabilizer-pos-rad</output>
            </aerosurface_scale>
            <fcs_function name="Pitch Trim Takeoff Norm">
                <function>
                    <table>
                        <independentVar>inertia/cg-x-in</independentVar>
                        <tableData>
                            366.31	1.0000
                            378.72	0.9474
                            385.34	0.6579
                            387.00	0.6579
                        </tableData>
                    </table>
                </function>
            </fcs_function>
            <summer name="Aileron Sum">
                <input>fcs/aileron-cmd-norm</input>
                <input>fcs/roll-trim-cmd-norm</input>
                <clipto><min>-1</min><max>1</max></clipto>
            </summer>
            <aerosurface_scale name="Aileron">
                <input>fcs/aileron-sum</input>
                <range><min>-0.3142</min><max>0.3142</max></range>
                <output>fcs/left-aileron-pos-rad</output>
            </aerosurface_scale>
            <pure_gain name="Right Aileron">
                <input>-fcs/left-aileron-pos-rad</input>
                <gain>1</gain>
                <output>fcs/right-aileron-pos-rad</output>
            </pure_gain>
            <washout_filter name="Yaw Rate Washout">
                <input>velocities/r-aero-rad_sec</input>
                <c1>0.5</c1>
            </washout_filter>
            <pure_gain name="Yaw Damper">
                <input>fcs/yaw-rate-washout</input>
                <gain>1.0</gain>
                <clipto><min>-0.2</min><max>0.2</max></clipto>
            </pure_gain>
            <summer name="Rudder Sum">
                <input>fcs/rudder-cmd-norm</input>
                <input>fcs/yaw-trim-cmd-norm</input>
                <input>fcs/yaw-damper</input>
                <clipto><min>-1</min><max>1</max></clipto>
            </summer>
            <aerosurface_scale name="Rudder">
                <input>fcs/rudder-sum</input>
                <range><min>-0.5236</min><max>0.5236</max></range>
                <output>fcs/rudder-pos-rad</output>
            </aerosurface_scale>
            <kinematic name="Flaps">
                <input>fcs/flap-cmd-norm</input>
                <traverse>
                    <setting>
                        <position> 0 </position>
                        <time> 0 </time>
                    </setting>
                    <setting>
                        <position> 8 </position>
                        <time> 3 </time>
                    </setting>
                    <setting>
                        <position> 20 </position>
                        <time> 4 </time>
                    </setting>
                    <setting>
                        <position> 40 </position>
                        <time> 6 </time>
                    </setting>
                </traverse>
                <output>fcs/flap-pos-deg</output>
            </kinematic>
            <kinematic name="Gear">
                <input>gear/gear-cmd-norm</input>
                <traverse>
                    <setting>
                        <position> 0 </position>
                        <time> 0 </time>
                    </setting>
                    <setting>
                        <position> 1 </position>
                        <time> 5 </time>
                    </setting>
                </traverse>
                <output>gear/gear-pos-norm</output>
            </kinematic>
            <kinematic name="Spoilers">
                <input>fcs/speedbrake-cmd-norm</input>
                <traverse>
                    <setting>
                        <position> 0 </position>
                        <time> 0 </time>
                    </setting>
                    <setting>
                        <position> 1 </position>
                        <time> 2 </time>
                    </setting>
                </traverse>
                <output>fcs/speedbrake-pos-norm</output>
            </kinematic>
        </channel>
