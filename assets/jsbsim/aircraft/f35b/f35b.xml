                <range><min>-0.4363</min><max>0.4363</max></range>
                <output>fcs/elevator-pos-rad</output>
            </aerosurface_scale>
            <summer name="Aileron Sum">
                <input>fcs/aileron-cmd-norm</input>
                <input>fcs/roll-trim-cmd-norm</input>
                <clipto><min>-1</min><max>1</max></clipto>
            </summer>
            <aerosurface_scale name="Aileron">
                <input>fcs/aileron-sum</input>
                <range><min>-0.4363</min><max>0.4363</max></range>
                <output>fcs/left-aileron-pos-rad</output>
            </aerosurface_scale>
            <pure_gain name="Right Aileron">
                <input>-fcs/left-aileron-pos-rad</input>
                <gain>1</gain>
                <output>fcs/right-aileron-pos-rad</output>
            </pure_gain>
            <washout_filter name="Yaw Rate Washout">
                <input>velocities/r-aero-rad_sec</input>
                <c1>0.5</c1>
            </washout_filter>
            <pure_gain name="Yaw Damper">
                <input>fcs/yaw-rate-washout</input>
                <gain>1.0</gain>
                <clipto><min>-0.2</min><max>0.2</max></clipto>
            </pure_gain>
            <summer name="Rudder Sum">
                <input>fcs/rudder-cmd-norm</input>
                <input>fcs/yaw-trim-cmd-norm</input>
                <input>fcs/yaw-damper</input>
                <clipto><min>-1</min><max>1</max></clipto>
            </summer>
            <aerosurface_scale name="Rudder">
                <input>fcs/rudder-sum</input>
                <range><min>-0.5236</min><max>0.5236</max></range>
                <output>fcs/rudder-pos-rad</output>
            </aerosurface_scale>
            <kinematic name="Gear">
                <input>gear/gear-cmd-norm</input>
                <traverse>
                    <setting>
                        <position> 0 </position>
                        <time> 0 </time>
                    </setting>
