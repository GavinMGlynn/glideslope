    <flight_control name="B-2A">
        <channel name="Controls">
            <pure_gain name="Pitch Damper">
                <input>velocities/q-aero-rad_sec</input>
                <gain>1.0</gain>
                <clipto><min>-0.3</min><max>0.3</max></clipto>
            </pure_gain>
            <summer name="Elevator Sum">
                <input>fcs/elevator-cmd-norm</input>
                <input>fcs/pitch-trim-cmd-norm</input>
                <input>fcs/pitch-damper</input>
                <clipto><min>-1</min><max>1</max></clipto>
            </summer>
            <aerosurface_scale name="Elevator">
                <input>fcs/elevator-sum</input>
                <range><min>-0.4363</min><max>0.4363</max></range>
                <output>fcs/elevator-pos-rad</output>
            </aerosurface_scale>
            <summer name="Aileron Sum">
                <input>fcs/aileron-cmd-norm</input>
                <input>fcs/roll-trim-cmd-norm</input>
                <clipto><min>-1</min><max>1</max></clipto>
            </summer>
            <aerosurface_scale name="Aileron">
                <input>fcs/aileron-sum</input>
                <range><min>-0.4363</min><max>0.4363</max></range>
                <output>fcs/left-aileron-pos-rad</output>
            </aerosurface_scale>
            <pure_gain name="Right Aileron">
                <input>-fcs/left-aileron-pos-rad</input>
                <gain>1</gain>
                <output>fcs/right-aileron-pos-rad</output>
            </pure_gain>
            <washout_filter name="Yaw Rate Washout">
                <input>velocities/r-aero-rad_sec</input>
                <c1>0.5</c1>
            </washout_filter>
            <pure_gain name="Yaw Damper">
                <input>fcs/yaw-rate-washout</input>
                <gain>3.0</gain>
                <clipto><min>-0.2</min><max>0.2</max></clipto>
            </pure_gain>
            <pure_gain name="Sideslip Feedback">
                <input>aero/beta-rad</input>
                <gain>-4.0</gain>
                <clipto><min>-0.5</min><max>0.5</max></clipto>
            </pure_gain>
            <summer name="Rudder Sum">
                <input>fcs/rudder-cmd-norm</input>
                <input>fcs/yaw-trim-cmd-norm</input>
                <input>fcs/yaw-damper</input>
                <input>fcs/sideslip-feedback</input>
                <clipto><min>-1</min><max>1</max></clipto>
            </summer>
            <aerosurface_scale name="Rudder">
                <input>fcs/rudder-sum</input>
                <range><min>-0.7854</min><max>0.7854</max></range>
                <output>fcs/rudder-pos-rad</output>
            </aerosurface_scale>
            <kinematic name="Gear">
                <input>gear/gear-cmd-norm</input>
                <traverse>
                    <setting>
                        <position> 0 </position>
                        <time> 0 </time>
                    </setting>
                    <setting>
                        <position> 1 </position>
                        <time> 8 </time>
                    </setting>
                </traverse>
                <output>gear/gear-pos-norm</output>
            </kinematic>
        </channel>
