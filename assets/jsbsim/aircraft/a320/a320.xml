            <function name="aero/coefficient/CDwindmill">
                <description>Drag_of_windmilling_engines</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <value>10.177</value>
                    <sum>
                        <difference><value>1</value><property>propulsion/engine[0]/set-running</property></difference>
                        <difference><value>1</value><property>propulsion/engine[1]/set-running</property></difference>
                    </sum>
                </product>
            </function>
