# The Gates Learjet 35A, two TFE731-2-2Bs: a flight model written for glideslope
# from its flight manual, its type certificate and NASA's measurements of the
# Learjet 23, and held to its flight manual's figures (assets/figures/
# learjet35a.xml), by tools/make_learjet35a.py.
#
#   name TEXT...                 what it is called
#   model NAME                   its JSBSim model, in data/jsbsim/aircraft
#   start AIRSPEED_KT THROTTLE   a flight begun in the air: its calibrated
#                                airspeed, and the throttle that holds it
#
# Its published figures, if it has them, are data/figures/MODEL.xml, and its
# selftest's log data/selftest/MODEL.log (src/sim/catalogue.hpp).

name Gates Learjet 35A
model learjet35a
class business-jet
start 250 0.49
# The speedbrake lever works its speedbrakes or spoilers (src/sim/catalogue.hpp).
speedbrakes
# Her main tyres and brakes, for a wet runway's grip (docs/ASSETS.md):
# Learjet 35/36 maintenance manual 12-10-05: 17.5x5.75-8 mains at 146-156 psi
# cold, loaded, the basic aeroplane's (the top of it taken); Jane's: fully
# modulated anti-skid.
brakes 156 fully-modulating
# Her gear-extended speed, VLE, knots (src/sim/catalogue.hpp): her limitations as crews' study sets give them for serials 443 and
# 509: 260 kt (operating 200).
gear-extended 260
# Her flap limit speeds, VFE, knots indicated, by flap (src/sim/catalogue.hpp):
# Gates Learjet 35A/36A Airplane Flight Manual FM-108, section I,
# limitations, page 1-9 (docs/ASSETS.md): "VFE - Flaps 1 to 8 degrees ...
# 200 KIAS"; flaps 9 to 20 degrees 185 KIAS for the serials named there
# without FCN 85-6, 200 for the rest - the lower is taken; "Flaps 21 to 40
# degrees ... 150 KIAS".
flap-limit 8 200
flap-limit 20 185
flap-limit 40 150
