# The Cessna 182S Skylane: JSBSim's c182 made to fly to its handbook's figures
# (assets/figures/c182.xml) by tools/make_c182.py.
#
#   name TEXT...                 what it is called
#   model NAME                   its JSBSim model, in data/jsbsim/aircraft
#   start AIRSPEED_KT THROTTLE   a flight begun in the air: its calibrated
#                                airspeed, and the throttle that holds it
#
# Its published figures, if it has them, are data/figures/MODEL.xml, and its
# selftest's log data/selftest/MODEL.log (src/sim/catalogue.hpp).

name Cessna 182S Skylane
model c182
class light-aircraft
start 120 0.65
# Leaned above 3,000 ft, as Cessna's 172P handbook has it (figure 5-6); the
# 182S's own gives its climb mixture as a placard of fuel flows by height.
mixture-lever 3000
# Her main tyres and brakes, for a wet runway's grip (docs/ASSETS.md):
# Cessna 182S Information Manual (1997), section 8: 6.00-6 mains at 42 psi;
# hydraulic disc brakes, no anti-skid.
brakes 42 none
# Her flap limit speeds, VFE, knots calibrated, by flap (src/sim/catalogue.hpp):
# Cessna 182S Information Manual, section 2, figure 2-1, airspeed
# limitations (docs/ASSETS.md): to 10 degrees 137 KCAS (140 KIAS), 10 to 20
# degrees 118 KCAS (120 KIAS), 20 degrees to full, her 38, 100 KCAS.
flap-limit 10 137
flap-limit 20 118
flap-limit 38 100
