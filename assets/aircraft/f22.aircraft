# The Lockheed Martin F-22A Raptor, two F119-PW-100s: JSBSim's f22 made to fly
# to the Department of Defense's and the Air Force's published figures
# (assets/figures/f22.xml) by tools/make_f22.py.
#
#   name TEXT...                 what it is called
#   model NAME                   its JSBSim model, in data/jsbsim/aircraft
#   start AIRSPEED_KT THROTTLE   a flight begun in the air: its calibrated
#                                airspeed, and the throttle that holds it
#
# Its published figures, if it has them, are data/figures/MODEL.xml, and its
# selftest's log data/selftest/MODEL.log (src/sim/catalogue.hpp).

name Lockheed Martin F-22A Raptor
model f22
class fighter
start 300 0.40
# The speedbrake lever works its speedbrakes or spoilers (src/sim/catalogue.hpp).
speedbrakes
# The autopilot's yaw damper at three times every other aircraft's, and its
# rudder integral at a tenth: at the defaults it swung her in a 20 kt
# crosswind up to 245 kt, and at either change alone up to 190
# (src/sim/autopilot.cpp).
yaw-damper 0.15 0.005
