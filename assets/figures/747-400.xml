<?xml version="1.0"?>
<!--
  The Boeing 747-400's published figures, and the conditions each was
  measured in.

  From Boeing's 747-400 Airplane Characteristics for Airport Planning
  (D6-58326-1, revision F, December 2024), for its General Electric engines,
  and the FAA's type certificate data sheet A20WE (revision 58). The checks
  in src/sim/figures.cpp fly one flight per <figure> and compare what JSBSim
  does with the range given here.

  The take-off runway length is read from the planning document's chart, to
  about 100 ft. The climb is the one FAR 25 demands with an engine out, which
  every airliner certificated to it meets; Boeing publishes no climb figure.
  The tolerances are this project's.
-->
<!--
  **touchdown_fpm** is the sink the AI's flare brings the wheels to the
  runway at. A jet is flown on to the runway rather than held off it to
  float (the FAA's Airplane Flying Handbook, FAA-H-8083-3C, chapter 16):
  two hundred feet a minute, and
  under the 6 ft/s (360 ft/min) NASA's go-around criteria study takes as
  its touchdown criterion - Zaal et al., "Go-Around Criteria Refinement for
  Transport Category Aircraft", AIAA Journal of Air Transportation, NTRS
  20205010611. A test holds every aircraft's to that. Held off to the
  forty a light aeroplane is, a B-2A in ground effect floated two
  kilometres down the runway.
-->
<published_figures aircraft="747-400" flaps_full_deg="30" touchdown_fpm="200">
  <source>Boeing D6-58326-1 rev F, 2024; FAA TCDS A20WE</source>

  <!-- 875,000 lb, the heaviest maximum take-off weight with GE engines (table
       2.1.1): the operating empty weight, 394,088 lb; a payload of 140,912
       lb, which makes the maximum zero-fuel weight, 535,000 lb; and 340,000
       lb of fuel. -->
  <loading name="maximum" total_lbs="875000">
    <pointmass index="0" lbs="140912"/>
    <tank index="0" lbs="68000"/>
    <tank index="1" lbs="68000"/>
    <tank index="2" lbs="68000"/>
    <tank index="3" lbs="68000"/>
    <tank index="4" lbs="68000"/>
  </loading>

  <!-- 574,000 lb, the maximum landing weight: the same payload and 39,000 lb
       of fuel, a weight in the cruise. -->
  <loading name="landing" total_lbs="574000">
    <pointmass index="0" lbs="140912"/>
    <tank index="0" lbs="7800"/>
    <tank index="1" lbs="7800"/>
    <tank index="2" lbs="7800"/>
    <tank index="3" lbs="7800"/>
    <tank index="4" lbs="7800"/>
  </loading>

  <!-- The operating empty weight and a tenth of the 360,225 lb of fuel it
       holds: as light as it flies. -->
  <loading name="light" total_lbs="430108">
    <pointmass index="0" lbs="0"/>
    <tank index="0" lbs="7204"/>
    <tank index="1" lbs="7204"/>
    <tank index="2" lbs="7204"/>
    <tank index="3" lbs="7204"/>
    <tank index="4" lbs="7204"/>
  </loading>

  <figure name="takeoff_field_length" loading="maximum" unit="ft" value="10500"
          tolerance_percent="10" flaps_deg="20" entry_kcas="200">
    Figure 3.3.1, page 3-13: FAR take-off runway length, standard day, sea
    level, flaps 20, air conditioning off, at 875,000 lb - about 10,500 ft,
    read from the chart.
  </figure>

  <figure name="climb_one_engine_out" flight="climb_gradient_one_engine"
          loading="maximum" unit="%" min="3.0" max="10" flaps_deg="20"
          entry_kcas="200">
    FAR 25.121(b), the 747-400's certification basis (A20WE): with one engine
    out, the take-off flaps, the gear up and V2, a four-engined aircraft
    climbs at no less than 3.0%. No figure above that is published; 10%
    bounds a model gone wrong.
  </figure>

  <figure name="cruise_mach" flight="level_mach" loading="landing" unit="Mach"
          min="0.85" max="0.95" altitude_ft="35000" mach="0.85">
    Level at 35,000 ft at full throttle, it must reach its cruise Mach, 0.85
    (the payload-range chart's, figure 3.2.1), and its drag rise hold it
    within 0.03 of its Mmo, 0.92 (A20WE).
  </figure>

  <figure name="ceiling" flight="climb_at_altitude" loading="light" unit="ft/min"
          min="300" max="100000" altitude_ft="45100" mach="0.85">
    A20WE: maximum operating altitude 45,100 ft. As light as it flies, at full
    throttle, it still climbs there at 300 ft/min, the margin that makes an
    altitude a thrust-limited ceiling.
  </figure>
  <!-- **The speeds a plan may fly her at**, measured by `glideslope_cli
       plan-speeds 747-400` on 2026-10-02 (linux-release): the tightest orbit a
       plan may ask at each speed (sim/orbit_trial.hpp), flown clean by the
       navigator and autopilot at 3,000 ft, both ways round, in calm air and
       in a 10 kt wind, each to hold its height within 50 ft and its speed
       within 5 kt, and a heading held on the autopilot alone in calm air
       and a 20 kt crosswind (sideslip within a degree, heading within two);
       the slowest sought up from its approach speed (or where said) in 5 kt steps,
       the fastest down from a fifth over its start speed, and written by
       the command's one rule (src/frontend/cli/main.cpp, plan_speeds). -->
  <plan_speeds slowest_kcas="220" fastest_kcas="300">
    The slowest, 220 kt, is 5 kt over the slowest that held: it publishes no stall speed, so has no approach speed, and the sweep began at 160 kt (`plan-speeds 747-400 160`); below 215 kt it came down 500 ft before it reached its circle (at 210 kt, its 6,381 m circle); 215 kt held all four ways. The fastest, 300 kt, a fifth over its start speed, held all four ways.
  </plan_speeds>
  <!-- **The slowest a glide may fly it at**, measured by `glideslope_cli
       glide-speeds 747-400` on 2026-10-06 (linux-release): from the slowest a
       route may fly it up in 5 kt steps, each glided round the tightest
       orbit allowed from 30,000 ft, every engine stopped, clean, both ways
       round (sim::glide_tightest_orbit), until one went round without its
       wing passing the angle its lift peaked at, nor 25 degrees. -->
  <glide_speeds slowest_kcas="235">
    235 kt; from 220, the slowest a route may fly it, to 230 it stalled.
  </glide_speeds>
  <!-- **Her take-off speeds, measured from her model, not published**: she
       publishes neither a rotation nor a climb speed. Measured by
       `glideslope_cli takeoff-speeds` on 2026-10-06 (linux-debug), the
       project owner's decision of that day (REQUIREMENTS.md section 9):
       taken off a level 3,500 m runway at sea level in calm air by the
       take-off autopilot (sim/takeoff_trial.hpp). -->
  <takeoff_speeds rotate_kcas="160" climb_kcas="190" flaps_deg="20" weight_lbs="754313">
    Rotation: from 100 kt in 5 kt steps, the first that lifted her off within 15 kt of itself, unwrecked, inside the 3,500 m runway, and never 5 kt slower once off, was 155 kt; 160 is written, 5 kt to spare. Rotated at 100 to 150 kt she ran on, and left the ground more than 15 kt past it - at 167 kt from 130 to 150. The climb away: asked 170 to 260 kt, at 500 ft she was never slower than 187.1 kt - the slowest she climbs away at with her nose held no higher than the take-off autopilot holds it - which is written rounded up. At flaps 20, the take-off field length's, and 754,313 lb, the weight her model flies a plan at.
  </takeoff_speeds>
</published_figures>
